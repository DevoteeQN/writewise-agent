# Placeholder only. Set this locally in .env; do not commit real database credentials.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_POSTGRES_API_KEY"

# Placeholder only. Generate a local value with `npx auth secret`; do not commit it.
AUTH_SECRET="YOUR_RANDOM_AUTH_SECRET"

# AI feedback provider. Defaults to mock when omitted.
AI_PROVIDER="mock"

# Required only when AI_PROVIDER="openai". Do not commit a real key.
OPENAI_API_KEY=""

# Optional OpenAI-compatible model name when AI_PROVIDER="openai".
AI_MODEL=""
