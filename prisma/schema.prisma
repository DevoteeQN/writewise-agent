// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String
  essays   Essay[]
  trainingPlans TrainingPlan[]
}

model WritingPrompt {
  id               Int      @id @default(autoincrement())
  title            String   @unique
  category         String
  difficulty       String
  targetSkill      String
  wordLimit        Int
  estimatedMinutes Int
  content          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  essays           Essay[]
}

model Essay {
  id          Int      @id @default(autoincrement())
  userId      String
  promptId    Int
  title       String
  content     String
  status      String   @default("submitted")
  wordCount   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  submittedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Restrict)
  feedbacks   AIFeedback[]
  sourceTrainingPlans TrainingPlan[]

  @@index([userId])
  @@index([promptId])
}

model AIFeedback {
  id                   Int      @id @default(autoincrement())
  essayId              Int
  overallScore         Float
  taskResponseScore    Float
  coherenceScore       Float
  lexicalScore         Float
  grammarScore         Float
  summary              String
  sentenceFeedbackJson Json
  improvedVersion      String
  weaknessTagsJson     Json
  nextExercise         String
  provider             String
  model                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  essay                Essay    @relation(fields: [essayId], references: [id], onDelete: Cascade)
  sourceTrainingPlans  TrainingPlan[]

  @@index([essayId])
}

model TrainingPlan {
  id               Int      @id @default(autoincrement())
  userId           String
  sourceEssayId    Int?
  sourceFeedbackId Int?
  title            String
  level            String
  focusSummary     String
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEssay      Essay?   @relation(fields: [sourceEssayId], references: [id], onDelete: SetNull)
  sourceFeedback   AIFeedback? @relation(fields: [sourceFeedbackId], references: [id], onDelete: SetNull)
  items            TrainingPlanItem[]

  @@index([userId])
  @@index([sourceEssayId])
  @@index([sourceFeedbackId])
}

model TrainingPlanItem {
  id               Int       @id @default(autoincrement())
  planId           Int
  week             Int
  day              Int
  theme            String
  taskTitle        String
  taskDescription  String
  targetSkill      String
  estimatedMinutes Int
  completed        Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  plan             TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@unique([planId, week, day])
}
